# ==============================================================================
# Art Flair - Sabahz Trading Backend Configuration
# ==============================================================================

# Flask Server
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True
PORT=5000
HOST=0.0.0.0

# Security Secrets (Generate a strong random 32+ char secret in production)
SECRET_KEY=sabahz_art_flair_master_secret_key_2026_atelier
JWT_SECRET_KEY=sabahz_jwt_secure_auth_token_signature_key_2026
JWT_EXPIRATION_HOURS=72

# MySQL 8.0 Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=art_flair_db

# Storage & Uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# CORS
CORS_ORIGINS=*
